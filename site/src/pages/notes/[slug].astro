---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getNotes, href, STATUS_LABEL, type Note } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note, notes } }));
}

interface Props { note: Note; notes: Note[] }
const { note, notes } = Astro.props;
const d = note.data;
const { Content } = await render(note);
const byId = new Map(notes.map((n) => [n.id, n]));
const related = d.related.map((id) => byId.get(id)).filter(Boolean) as Note[];
const host = new URL(d.url).hostname.replace(/^www\./, "");
---
<Base title={d.title} description={d.tldr}>
  <article class="note">
    <a class="back" href={href("/")} data-pagefind-ignore>← Toutes les fiches</a>
    <h1>{d.title}</h1>
    <p class="tldr">{d.tldr}</p>

    <dl class="facts" data-pagefind-ignore>
      <div><dt>Source</dt><dd><a href={d.url}>{host} ↗</a></dd></div>
      {d.authors.length > 0 && <div><dt>Auteurs</dt><dd>{d.authors.join(", ")}</dd></div>}
      {d.published && <div><dt>Publié</dt><dd>{d.published}</dd></div>}
      <div><dt>Statut</dt><dd><span class="status" data-s={d.status}>{STATUS_LABEL[d.status]}</span></dd></div>
      <div class="span">
        <dt>Tags</dt>
        <dd class="tags">{d.tags.map((t) => <a class="tag" href={href(`/tags/${t}/`)} data-pagefind-filter="tag">{t}</a>)}</dd>
      </div>
    </dl>

    <div class="prose">
      <Content />
    </div>

    {related.length > 0 && (
      <aside class="related" data-pagefind-ignore>
        <h2>Fiches liées</h2>
        <ul>
          {related.map((r) => (
            <li><a href={href(`/notes/${r.id}/`)}>{r.data.title}</a><span>{r.data.tldr}</span></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Base>

<style>
  .note { max-width: 70ch; }
  .back { font-size: 0.85rem; color: var(--muted); text-decoration: none; }
  h1 { margin-top: 14px; }
  .tldr { font: 1.2rem/1.5 var(--serif); color: var(--muted); margin: 6px 0 22px; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px 20px;
    margin: 0 0 28px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 0.88rem;
  }
  .facts dt { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .facts dd { margin: 2px 0 0; }
  .facts .span { grid-column: 1 / -1; }
  .facts .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .prose { font: 1.08rem/1.7 var(--serif); }
  .prose :global(h2) { font-size: 1.35rem; margin: 2em 0 0.5em; padding-top: 0.6em; border-top: 1px solid var(--line); }
  .prose :global(ul) { padding-left: 1.2em; }
  .prose :global(li) { margin: 0.35em 0; }
  .prose :global(li::marker) { color: var(--accent); }
  .related { margin-top: 40px; padding-top: 18px; border-top: 2px solid var(--ink); }
  .related h2 { font-size: 1.1rem; margin: 0 0 10px; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .related li { display: grid; gap: 2px; }
  .related span { color: var(--muted); font-size: 0.9rem; }
</style>
