---
import Base from "../../layouts/Base.astro";
import NoteCard from "../../components/NoteCard.astro";
import { getNotes, allTags, href, type Note } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return allTags(notes).map(([tag]) => ({
    params: { tag },
    props: { tag, notes: notes.filter((n) => n.data.tags.includes(tag)) },
  }));
}

interface Props { tag: string; notes: Note[] }
const { tag, notes } = Astro.props;
---
<Base title={`#${tag}`} current="tags">
  <a class="back" href={href("/tags/")}>← Tous les tags</a>
  <h1><code>{tag}</code></h1>
  <p class="lede">{notes.length} fiche{notes.length > 1 ? "s" : ""}</p>
  <div class="list">{notes.map((n) => <NoteCard note={n} />)}</div>
</Base>

<style>
  .back { font-size: 0.85rem; color: var(--muted); text-decoration: none; }
  h1 { margin-top: 14px; }
  h1 code { font-size: 0.85em; background: none; padding: 0; }
  .list { display: grid; gap: 14px; }
</style>
