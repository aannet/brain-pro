---
import Base from "../layouts/Base.astro";
import { href } from "../lib/notes";
---
<Base title="Recherche" current="search">
  <h1>Recherche</h1>
  <p class="lede">Plein texte dans toutes les fiches. L'index est construit au build, sans serveur.</p>
  <link href={href("/pagefind/pagefind-ui.css")} rel="stylesheet" />
  <div id="search"></div>
  <script is:inline define:vars={{ base: href("/") }}>
    const s = document.createElement("script");
    s.src = base + "pagefind/pagefind-ui.js";
    s.onload = () =>
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: { placeholder: "Rechercher dans les fiches…", zero_results: "Aucun résultat pour [SEARCH_TERM]" },
      });
    s.onerror = () => {
      document.querySelector("#search").textContent = "Index absent : lancer npm run build (la recherche ne marche pas en mode dev).";
    };
    document.head.appendChild(s);
  </script>
</Base>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--tag-bg);
    --pagefind-ui-font: var(--sans);
  }
</style>
