---
import Base from "../layouts/Base.astro";
import NoteCard from "../components/NoteCard.astro";
import { getNotes, allTags, STATUS_LABEL } from "../lib/notes";

const notes = await getNotes();
const tags = allTags(notes);
---
<Base title="brain-pro" current="index">
  <h1>Fiches de lecture</h1>
  <p class="lede">{notes.length} fiche{notes.length > 1 ? "s" : ""} sur l'AI engineering : agents, evals, RAG, context engineering, outillage.</p>

  <div class="filters">
    <input id="q" type="search" placeholder="Filtrer par titre, tag, auteur…" aria-label="Filtrer les fiches" />
    <div class="row" role="group" aria-label="Statut">
      <button class="chip" data-status="" aria-pressed="true">Tous</button>
      {Object.entries(STATUS_LABEL).map(([k, v]) => <button class="chip" data-status={k} aria-pressed="false">{v}</button>)}
    </div>
    <div class="row" role="group" aria-label="Tags">
      {tags.map(([t, n]) => <button class="chip tagchip" data-tag={t} aria-pressed="false">{t} <small>{n}</small></button>)}
    </div>
  </div>

  <p id="count" class="count" aria-live="polite"></p>
  <div class="list">
    {notes.map((n) => <NoteCard note={n} />)}
  </div>
</Base>

<style>
  .filters { display: grid; gap: 10px; margin-bottom: 18px; }
  #q {
    width: 100%;
    font: inherit;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
  }
  #q:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .row { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    font: 0.82rem var(--sans);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    padding: 3px 10px;
    border-radius: 999px;
    cursor: pointer;
  }
  .tagchip { font-family: var(--mono); }
  .chip small { color: var(--muted); }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chip[aria-pressed="true"] small { color: inherit; opacity: 0.7; }
  .count { font-size: 0.85rem; color: var(--muted); margin: 0 0 10px; }
  .list { display: grid; gap: 14px; }
</style>

<script>
  const q = document.querySelector<HTMLInputElement>("#q")!;
  const cards = [...document.querySelectorAll<HTMLElement>(".card")];
  const count = document.querySelector("#count")!;
  let status = "";
  const tags = new Set<string>();

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok =
        (!status || c.dataset.status === status) &&
        [...tags].every((t) => c.dataset.tags!.split(" ").includes(t)) &&
        (!term || c.dataset.text!.includes(term));
      c.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = shown === cards.length ? "" : `${shown} fiche(s) sur ${cards.length}`;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-status]").forEach((b) => {
    if (!(b instanceof HTMLButtonElement)) return;
    b.addEventListener("click", () => {
      status = b.dataset.status!;
      document.querySelectorAll("button[data-status]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      apply();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("button[data-tag]").forEach((b) => {
    b.addEventListener("click", () => {
      const t = b.dataset.tag!;
      tags.has(t) ? tags.delete(t) : tags.add(t);
      b.setAttribute("aria-pressed", String(tags.has(t)));
      apply();
    });
  });
  q.addEventListener("input", apply);
</script>
