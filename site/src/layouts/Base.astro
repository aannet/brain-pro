---
import { href } from "../lib/notes";

interface Props {
  title: string;
  description?: string;
  current?: "index" | "anti-patterns" | "tags" | "search";
}
const { title, description = "Fiches de lecture sur l'AI engineering", current } = Astro.props;
const nav = [
  { key: "index", label: "Fiches", path: "/" },
  { key: "tags", label: "Tags", path: "/tags/" },
  { key: "anti-patterns", label: "À ne pas faire", path: "/anti-patterns/" },
  { key: "search", label: "Recherche", path: "/search/" },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "brain-pro" ? title : `${title} · brain-pro`}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={href("/")}>brain<span>·</span>pro</a>
      <nav>
        {nav.map((n) => (
          <a href={href(n.path)} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main data-pagefind-body={current ? undefined : ""}>
      <slot />
    </main>
    <footer>
      Fiches paraphrasées, chaque source reste à ses auteurs · <a href="https://github.com/aannet/brain-pro">GitHub</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f4ef;
    --surface: #fffdf8;
    --ink: #1d1c1a;
    --muted: #6b675f;
    --line: #e2ddd2;
    --accent: #b4441c;
    --accent-soft: #f3e1d7;
    --warn-bg: #fbeee8;
    --tag-bg: #ece8de;
    --serif: "Newsreader", Georgia, serif;
    --sans: "IBM Plex Sans", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #151413;
      --surface: #1d1c1a;
      --ink: #ece8df;
      --muted: #a29d93;
      --line: #33302c;
      --accent: #f08a5d;
      --accent-soft: #3a2519;
      --warn-bg: #2c1e18;
      --tag-bg: #2a2825;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.6 var(--sans);
  }
  a { color: inherit; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  code { font: 0.88em var(--mono); background: var(--tag-bg); padding: 0.1em 0.35em; border-radius: 4px; }
  .top {
    max-width: 920px;
    margin: 0 auto;
    padding: 20px 16px 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .brand { font: 600 1.35rem var(--serif); text-decoration: none; letter-spacing: -0.01em; }
  .brand span { color: var(--accent); }
  .top nav { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 0.92rem; }
  .top nav a { text-decoration: none; color: var(--muted); }
  .top nav a[aria-current="page"] { color: var(--ink); box-shadow: inset 0 -2px var(--accent); }
  main { max-width: 920px; margin: 0 auto; padding: 28px 16px 48px; }
  footer {
    max-width: 920px;
    margin: 0 auto;
    padding: 18px 16px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.82rem;
  }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); margin: 0 0 8px; }
  .lede { color: var(--muted); margin: 0 0 24px; max-width: 60ch; }
  .tag {
    display: inline-block;
    font: 0.78rem var(--mono);
    background: var(--tag-bg);
    color: var(--ink);
    padding: 1px 8px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }
  a.tag:hover { background: var(--accent-soft); color: var(--accent); }
  .status { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .status[data-s="inbox"] { color: var(--accent); }
</style>
