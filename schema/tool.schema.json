{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool",
  "type": "object",
  "required": ["name", "url", "tags", "radar", "pricing", "added", "pitch"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 2 },
    "url": { "type": "string", "pattern": "^https?://" },
    "repo": { "type": ["string", "null"], "pattern": "^https://github\\.com/" },
    "tags": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "radar": { "enum": ["assess", "trial", "adopt", "hold"] },
    "pricing": { "enum": ["open-source", "freemium", "paid"] },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pitch": { "type": "string", "minLength": 10, "maxLength": 200 },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "seen_in": { "type": "array", "items": { "type": "string" } }
  }
}
