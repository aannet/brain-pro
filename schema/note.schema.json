{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reading note",
  "type": "object",
  "required": [
    "title",
    "url",
    "type",
    "added",
    "tags",
    "status",
    "tldr"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "type": {
      "enum": [
        "article",
        "paper",
        "blog",
        "doc",
        "talk",
        "video",
        "repo",
        "book"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "published": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "status": {
      "enum": [
        "inbox",
        "read",
        "deep-dive"
      ]
    },
    "rating": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "tldr": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
